{
  "name": "fog-of-lore",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted tabletop RPG game-master companion",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "predev": "pnpm --filter @fog-of-lore/contracts --filter @fog-of-lore/domain --filter @fog-of-lore/ui build",
    "dev": "pnpm --parallel --filter @fog-of-lore/web --filter @fog-of-lore/api dev",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:integration": "pnpm --filter @fog-of-lore/api test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @fog-of-lore/api db:generate",
    "db:migrate": "pnpm --filter @fog-of-lore/api db:migrate",
    "db:seed": "pnpm --filter @fog-of-lore/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "globals": "17.7.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
