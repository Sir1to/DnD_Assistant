{$FOG_OF_LORE_DOMAIN:localhost} {
	encode zstd gzip

	@api path /api/*
	handle @api {
		reverse_proxy api:4000
	}

	@websocket path /socket.io/*
	handle @websocket {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
