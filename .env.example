NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
NEXT_PUBLIC_API_URL=http://localhost:4000/api
SESSION_TTL_DAYS=30
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
FILE_STORAGE_PATH=./data

# `pnpm release:build` sets these automatically for release images.
APP_VERSION=0.1.0
APP_COMMIT=development
APP_BUILD_TIME=

POSTGRES_DB=fog_of_lore
POSTGRES_USER=fog_of_lore
POSTGRES_PASSWORD=replace-with-a-long-random-value
DATABASE_URL=postgresql://fog_of_lore:replace-with-a-long-random-value@localhost:5432/fog_of_lore

# Only used by `pnpm db:seed`; do not reuse this value outside local development.
DEMO_PASSWORD=replace-with-a-local-demo-password
